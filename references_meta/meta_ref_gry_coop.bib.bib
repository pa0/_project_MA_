	month = {11},
	pages = {447:1--447:26},
	shortjournal = {Proc. {ACM} Hum.-Comput. Interact.},
	shorttitle = {{LAGH}},
	title = {{LAGH}: Towards Asymmetrical Collaborative Bodily Play between 1st and 2nd Person Perspectives},
	url = {https://doi.org/10.1145/3555548},
	urlyear = {2023-11-16},
	volume = {6},
