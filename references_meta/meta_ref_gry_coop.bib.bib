@thesis{Evensen2022,
	abstract = {Sammendrag Bakgrunn: Gaming en sv{\ae}rt utbredt aktivitet, og en sosial arena for mange. Det er et {\aa}penbart behov for en mer nyansert anerkjennelse av forskjellige spillatferder blant ungdom, da mesteparten av forskning kun omfavner avhengighet. Ulike sosiale helseutfall i ulike typer spillatferd trenger {\aa} bli belyst fra et mer balansert perspektiv. Hensikt: Unders{\o}ke sammenhengen mellom ulike {GAS} spillatferder og sosial mestringstro, og utforske om familiest{\o}tte modererer disse sammenhengene. Metode: Denne studien bruker sekund{\ae}rdata fra Helsevaner blant Skoleungdom unders{\o}kelsen ({HBSC}, 2018), en {WHO}-studie utf{\o}rt i Norge av Universitetet i Bergen. F{\o}rst ble gruppe- og kj{\o}nnsforskjeller unders{\o}kt i hovedvariablene. Deretter ble forholdet mellom spillatferder og sosial mestringstro, samt virkningen av familiest{\o}tte unders{\o}kt gjennom hierarkisk multippel regresjonsanalyse og moderasjonsanalyse. Resultat: En tredjedel av utvalget ble klassifisert til {\aa} ha en {GAS}-atferd, hvorav de fleste var problematiske spillere. Spillatferd var mer vanlig hos gutter. Sosial mestringstro var signifikant lavere i alle spillgruppene sammenlignet med referansegruppen og var lavest i den avhengige gruppen. Familiest{\o}tte modererte ikke forholdet mellom noen av spillatferdene og sosial mestringstro, men hadde en liten, positiv direkte effekt p{\aa} sosial mestringstro. Konklusjon: Denne studien antyder et behov for flere longitudinelle studier av disse sammenhengene. Det er ogs{\aa} et klart behov for at fremtidig forskning inkluderer den digitale verden i konstruktet til sosial mestringstro n{\aa}r man ser p{\aa} {GAS}-atferd. Vi oppfordrer ogs{\aa} videre forskning til {\aa} bruke m{\aa}leinstrumenter for familiest{\o}tte som kan knyttes mer til spillatferd n{\aa}r det unders{\o}kes familiemilj{\o}er som beskyttende faktorer for negative utfall av {GAS}-atferd},
	author = {Evensen, Simen Adrian and Sognnes, {\O}rjan},
	date-modified = {2026-04-06 14:45:53 +0200},
	file = {Full Text PDF:/Users/_pao_/Documents/Uczelnie/Zotero/storage/WMX4LB3T/Evensen i Sognnes - 2022 - What is the relationship between gaming behaviors .pdf:application/pdf},
	institution = {The University of Bergen},
