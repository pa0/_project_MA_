	journal = {{OR} Spectrum},
	langid = {english},
	number = {1},
	pages = {1--25},
	shortjournal = {{OR} Spectrum},
	title = {Two-step Shapley-solidarity value for cooperative games with coalition structure},
	url = {https://doi.org/10.1007/s00291-022-00694-9},
	urlyear = {2023-11-16},
