@article{Boduszek2019,
	abstract = {Evidence demonstrates that exposure to prosocial video games can increase players' prosocial behaviour, prosocial thoughts, and empathic responses. Prosocial gaming has also been used to reduce gender-based violence among young people, but the use of video games to this end as well as evaluations of their effectiveness are rare. The objective of this study was to assess the effectiveness of a context-specific, prosocial video game, Jesse, in increasing affective and cognitive responsiveness (empathy) towards victims of intimate partner violence ({IPV}) among children and adolescents (N = 172, age range 9--17 years, M = 12.27, {SD} = 2.26). A randomised controlled trial was conducted in seven schools in Barbados. Participants were randomly assigned to an experimental (prosocial video game) or control (standard school curriculum) condition. Experimental and control group enrolled 86 participants each. Girls and boys in the experimental condition, but not their counterparts in the control condition, recorded a significant increase in affective responsiveness after intervention. This change was sustained one week after game exposure. No significant effects were recorded for cognitive responsiveness. Findings suggest that Jesse is a promising new {IPV} prevention tool among girls and boys, which can be used in educational settings.},
	annote = {Affective and cognitive responsiveness, Caribbean, Intimate partner violence ({IPV}) prevention, Prosocial video game, Randomised controlled trial, Youth},
	author = {Boduszek, Daniel and Debowska, Agata and Jones, Adele D. and Ma, Minhua and Smith, David and Willmott, Dominic and Trotman Jemmott, Ena and Da Breo, Hazel and Kirkman, Gillian},
	date-modified = {2026-04-06 16:28:36 +0200},
	doi = {10.1016/j.chb.2018.12.028},
	file = {ScienceDirect Snapshot:/Users/_pao_/Documents/Uczelnie/Zotero/storage/JYUNE7LZ/S0747563218306149.html:text/html;Zaakceptowana wersja:files/712/Boduszek et al. - 2019 - Prosocial video game as an intimate partner violen.pdf:application/pdf},
	issn = {0747-5632},
	journal = {Computers in Human Behavior},
	keywords = {tak},
	langid = {english},
	month = {04},
	pages = {260--266},
	shortjournal = {Computers in Human Behavior},
	shorttitle = {Prosocial video game as an intimate partner violence prevention tool among youth},
	title = {Prosocial video game as an intimate partner violence prevention tool among youth: A randomised controlled trial},
	url = {https://www.sciencedirect.com/science/article/pii/S0747563218306149},
	urlyear = {2021-04-10},
	volume = {93},
	year = {2019},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0747563218306149}}

@thesis{Jensen2017,
	abstract = {The differences in results across research demonstrate that the social and psychological effects, positive or negative, of video games can be influenced by many variables, including play style and social context (Anderson et al., 2010; Ferguson \& Kilburn, 2010; Greitemeyer and Oswald, 2010; Ewoldsen et al., 2012). The purpose of this study was to determine if face-to-face game play (social context) would result in more prosocial behaviors in both cooperative as well as competitive game play (play style), as compared to online play. Participants played Mario Kart 8 in pairs competitively or cooperatively and online or face-to-face. Participants then played a game where each decided how many dimes to give to the other participant over ten trials in order to measure generosity. A 2x2 between-subjects factorial {ANOVA} was calculated for the mean number of dimes given to the other participant. Results showed that participants who played the Mario Kart 8 video game under the cooperative play style condition gave significantly more dimes to the other participant (M = 24.96, {SD} = 8.65) than participants who played the video game under the competitive play style condition (M = 18.67, {SD} = 8.32). The main effect for whether the video game was played face-to-face or online was not significant (F(1, 90) = 2.19, p {\textless} .05, partial η2 = ..024). Participants who played the video game face-to-face (M = 20.54, {SD} = 7.52) were not significantly different from participants who played the video game online (M = 23.28, {SD} = 10.25) in the number of dimes given. Finally, the interaction was not significant. Effects of participants' level of familiarity with one another and comparisons to past research on the effects of play style in video games is discussed.},
	author = {Jensen, Jasmine},
	date-modified = {2026-04-06 14:45:53 +0200},
	file = {Jensen - 2017 - The Effect of Video Games on Prosocial Behavior T.pdf:/Users/_pao_/Documents/Uczelnie/Zotero/storage/PY2U9NVZ/Jensen - 2017 - The Effect of Video Games on Prosocial Behavior T.pdf:application/pdf},
	shorttitle = {The Effect of Video Games on Prosocial Behavior},
	title = {The Effect of Video Games on Prosocial Behavior: The Interaction of Play Style and Social Context},
	type = {phdthesis},
	year = {2017-08-22}}

@incollection{Apostolakis2016,
	abstract = {In this paper, a two-player digital game is presented, that attempts to balance the exciting game content and story-driven elements mostly associated with games in the entertainment industry with a serious game agenda. The latter focuses on teaching children aged 7-10 the importance of understanding the benefits of cooperation as well as expressing trustworthiness. Gamification of Prosocial Theory has led to several game mechanics being redefined, in order to turn traditional games' elements of competition into cooperation evaluation mechanisms. Using these mechanisms, children are called upon to adapt their gameplay behavior towards expressing prosociality and understanding each other's needs. Our experiments solidify this concept, by showcasing promising indications on the game's potential to help children understand when it is a good idea to adopt a prosocial behavior.},
	author = {Apostolakis, Konstantinos C. and Kaza, Kyriaki and Psaltis, Athanasios and Stefanidis, Kiriakos and Thermos, Spyridon and Dimitropoulos, Kosmas and Dimaraki, Evaggelia and Daras, Petros},
