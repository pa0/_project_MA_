	rights = {Attribution-{NonCommercial}-{NoDerivatives} 4.0 International},
	shorttitle = {How Game Features Give Rise to Altruism and Collective Action?},
	title = {How Game Features Give Rise to Altruism and Collective Action? Implications for Cultivating Cooperation by Gamification},
	url = {http://scholarspace.manoa.hawaii.edu/handle/10125/63825},
	urlyear = {2021-04-16},
