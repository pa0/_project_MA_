@article{Zou2023,
	abstract = {This paper proposes an alternative for the two-step Shapley value for cooperative games with coalition structure that has earlier been proposed by Kamijo. The value is based on the idea that within a union of players, worth should be distributed based on the solidarity principle. Specifically, we propose a two-step Shapley-solidarity value, in which the surplus of a union's Shapley value in the quotient game is distributed equally among the union's members, and players obtain the solidarity value of the respective subgame within their union. We provide an intuitive procedural characterization for this value and give three axiomatizations to pinpoint the differences to comparable values.},
	annote = {91A12, Axiomatization, C71, Coalition structure, Cooperative games, Procedural characterization, Solidarity},
	author = {Zou, Rong and Li, Wenzhong and Uetz, Marc and Xu, Genjiu},
