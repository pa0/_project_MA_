@article{Modafferi,
	abstract = {Acquiring skills for social and emotional well-being is important for inclusive societies and academic achievement. Studies have demonstrated the beneficial link between prosocial behaviours and improved results in curriculum topics. This paper describes a Prosocial Learning ({PSL}) process for creation and delivery of digital games for children (7-10 yrs) within educational systems that support learning of prosocial skills. The approach combines prosocial pedagogies with advanced {ICT} technologies and cloud delivery models to create attractive and exciting learning opportunities for children; produce novel digital game-based pedagogies and simplify deployment.},
