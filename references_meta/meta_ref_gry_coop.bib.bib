@article{Kammermann2024,
	abstract = {Prosocial behaviours are actions that have a positive impact on others. Those who act prosocially in videogames are more likely to be prosocial after the game. In-game rewards may impact this prosocial transfer to real life but there are mixed findings. The aim of this research was to determine the impact that in-game rewards for helping have on post-game prosocial behaviour. We partially replicated and extended a prior study that showed an impact of in-game rewards on a post-game charitable donation. While playing a videogame, players voluntarily chose to help a non-player character or not and were rewarded or not based on their experimental condition. Pre- and post-gameplay questionnaires were used to measure trait empathy, prosocial self-concept, and reasoning for in-game helping. Participants were then offered a bonus compensation and given the opportunity to donate some amount of it to charity. Moral Reasoning was positively associated with donation behaviour, successfully replicating some prior findings. However, in-game rewards did not affect reasoning or donation behaviour. The outcomes of this research help both researchers and developers better understand how rewards affect players' reasoning and how to better utilise games as a method to increase prosocial behaviour in people.},
	annote = {Prosocial behaviour, Custom videogame, Prolific, Videogame rewards},
	author = {Kammermann, Blake and T{\"u}rkay, Selen and Johnson, Daniel and Tobin, Stephanie J.},
	date-modified = {2026-04-06 14:45:53 +0200},
	doi = {10.1016/j.ijhcs.2023.103143},
	file = {ScienceDirect Full Text PDF:/Users/_pao_/Documents/Uczelnie/Zotero/storage/G3D2LZPG/Kammermann et al. - 2024 - Do videogame rewards influence players' subsequent.pdf:application/pdf;ScienceDirect Snapshot:/Users/_pao_/Documents/Uczelnie/Zotero/storage/DJ3BM4N9/S1071581923001520.html:text/html},
	issn = {1071-5819},
	journal = {International Journal of Human-Computer Studies},
	month = {01},
	pages = {103143},
	shortjournal = {International Journal of Human-Computer Studies},
	shorttitle = {Do videogame rewards influence players' subsequent prosocial engagement?},
	title = {Do videogame rewards influence players' subsequent prosocial engagement? A preregistered partial replication study on the role of reward and reasoning},
	url = {https://www.sciencedirect.com/science/article/pii/S1071581923001520},
	urlyear = {2023-11-16},
	volume = {181},
	year = {2024},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S1071581923001520}}

