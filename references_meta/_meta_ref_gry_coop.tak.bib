@article{Roussos2016,
	abstract = {A plethora of research indicates that viewing media can reduce prejudice. Emerging work on computer gaming shows that games can also influence social attitudes. The present studies investigated the influence of an interactive computer game about living in poverty on attitudes and beliefs about the poor. Playing the poverty game was compared to playing a control game and merely observing the poverty game. In Study 1, playing an interactive poverty game did not influence attitudes while watching someone else play the game increased positive attitudes, empathic concern, and support for government-funded anti-poverty policies. In Study 2, meritocracy beliefs moderated the influence of the game; people lower in meritocracy showed less positive attitudes toward the poor after playing the poverty game. This effect was mediated by an increase in the belief that poverty is personally controllable. Future directions for and implications of studying the unique intergroup effects of games are discussed.},
	annote = {attitude change, controllability, media, poverty, Prejudice/stereotyping},
	author = {Roussos, Gina and Dovidio, John F.},
